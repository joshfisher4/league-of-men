/* ===========================
   LEAGUE OF MEN
   Official Stylesheet
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    background:#0b0b0b;
    color:white;

    font-family:'Inter',sans-serif;

}

/* HERO */

.hero{

    height:70vh;

    display:flex;
    flex-direction:column;

    justify-content:center;
    align-items:center;

    text-align:center;

    background:
    linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.85)),
    radial-gradient(circle at top,#2d2d2d,#0b0b0b);

    border-bottom:3px solid gold;

}

.hero h1{

    font-size:80px;

    font-family:'Oswald',sans-serif;

    color:gold;

    letter-spacing:6px;

    text-transform:uppercase;

}

.subtitle{

    margin-top:15px;

    font-size:22px;

    color:#dddddd;

}

.tagline{

    margin-top:30px;

    font-size:30px;

    font-weight:bold;

}

/* NAVIGATION */

nav{

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:25px;

    background:#111;

    padding:22px;

    border-bottom:1px solid #2c2c2c;

}

nav a{

    color:white;

    text-decoration:none;

    font-size:18px;

    font-weight:600;

    transition:.3s;

}

nav a:hover{

    color:gold;

}

/* CONTENT */

section{

    width:90%;

    max-width:1200px;

    margin:auto;

}

.welcome{

    text-align:center;

    padding:70px 0;

}

.welcome h2{

    color:gold;

    font-size:42px;

    margin-bottom:25px;

}

.welcome p{

    color:#cccccc;

    line-height:1.8;

    font-size:19px;

}

/* CARDS */

.cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:25px;

    margin-bottom:80px;

}

.card{

    background:#171717;

    padding:35px;

    border-radius:18px;

    border:1px solid #333;

    transition:.3s;

    cursor:pointer;

}

.card:hover{

    transform:translateY(-10px);

    border-color:gold;

    box-shadow:0 0 25px rgba(255,215,0,.4);

}

.card h3{

    color:gold;

    margin-bottom:15px;

}

.card p{

    color:#cfcfcf;

    line-height:1.7;

}

/* CHAMPIONS */

.champions{

    margin-bottom:100px;

}

.champions h2{

    text-align:center;

    color:gold;

    margin-bottom:35px;

    font-size:42px;

}

.champions ul{

    list-style:none;

}

.champions li{

    background:#171717;

    padding:18px;

    margin-bottom:15px;

    border-left:5px solid gold;

    border-radius:10px;

    font-size:20px;

}

/* FOOTER */

footer{

    background:#111;

    text-align:center;

    padding:35px;

    color:#999;

    border-top:1px solid #333;

}

/* MOBILE */

@media(max-width:700px){

.hero{

height:60vh;

}

.hero h1{

font-size:46px;

letter-spacing:2px;

}

.tagline{

font-size:22px;

}

.welcome h2{

font-size:30px;

}

nav{

gap:15px;

}

}